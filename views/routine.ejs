<%- include('partials/head', { title, wide: true, routine: true }) %>

<div class="routine-head">
  <h1>Your Routines</h1>
  <p class="margin-note">one new thing at a time</p>
</div>

<%# On narrow screens one routine is shown and these links switch between them (real pages, so they work
    without JavaScript). Above 1000px both routines are shown side by side and the links are hidden. %>
<nav class="seg" aria-label="Routine">
  <% page.panels.forEach((panel) => { %>
    <a class="seg__item" href="/routines/<%= panel.period %>"<%- panel.isCurrent ? ' aria-current="page"' : '' %>><%= panel.shortLabel %></a>
  <% }) %>
</nav>

<div class="routines">
  <% page.panels.forEach((panel) => { %>
    <section class="routine<%= panel.isCurrent ? ' routine--current' : '' %>" aria-labelledby="routine-<%= panel.period %>-title">
      <h2 class="routine__title" id="routine-<%= panel.period %>-title"><img class="doodle routine__art" src="/illustrations/<%= panel.period === 'am' ? 'sun' : 'moon' %>.svg" alt="" width="60" height="60"><%= panel.label %></h2>

      <% if (panel.items.length === 0) { %>
        <p>Nothing in this routine yet.</p>
      <% } else { %>
        <ol class="steps">
          <% panel.items.forEach((item, index) => { %>
            <li class="step" style="--i: <%= index %>">
              <span class="step__number" aria-hidden="true"><%= item.step %></span>
              <%- include('partials/product-icon', { category: item.mainCategory, art: item.id }) %>
              <div class="step__main">
                <strong class="step__name"><%= item.name %></strong>
                <% if (item.actives.length === 0) { %>
                  <span class="list__meta">No known actives found</span>
                <% } else { %>
                  <ul class="chips" aria-label="Known actives in <%= item.name %>">
                    <% item.actives.forEach((active) => { %>
                      <li><%- include('partials/chip', { text: active.name, category: active.category }) %></li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
              <form method="post" action="/routines/<%= panel.period %>/items/<%= item.id %>/delete" class="step__remove">
                <%- include('partials/csrf') %>
                <button type="submit" aria-label="Remove <%= item.name %>"><span aria-hidden="true">×</span></button>
              </form>
            </li>
          <% }) %>
        </ol>
      <% } %>

      <% if (panel.available.length > 0) { %>
        <form method="post" action="/routines/<%= panel.period %>/items" class="add">
          <%- include('partials/csrf') %>
          <label for="product_id_<%= panel.period %>">+ Add a Product</label>
          <select id="product_id_<%= panel.period %>" name="product_id">
            <% panel.available.forEach((product) => { %>
              <option value="<%= product.id %>"><%= product.name %></option>
            <% }) %>
          </select>
          <button type="submit" class="button button--small">Add</button>
        </form>
      <% } else if (!panel.hasAnyProduct) { %>
        <p><a href="/products">Add a product</a> first, then you can put it in this routine.</p>
      <% } else { %>
        <p class="field__hint">All your products are already in this routine.</p>
      <% } %>

      <h3 class="routine__subhead">Conflicts</h3>

      <% if (panel.conflicts.status === 'conflicts') { %>
        <% panel.warnings.forEach((warning, index) => { %>
          <article class="insight insight--<%= warning.severity %>" style="--i: <%= index %>">
            <%# A triangle and the level in words, so the card never relies on colour alone %>
            <p class="insight__badge">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 2.5 18.5 17.5H1.5Z" fill="#FF7A45" stroke="#151515" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 8v4.2M10 14.3v.2" stroke="#151515" stroke-width="1.8" stroke-linecap="round"/></svg>
              <%= warning.level %>
            </p>
            <h4 class="insight__title"><%= warning.headline %><span class="status-live">: <%= warning.title %></span></h4>
            <ul class="chips" aria-label="The two actives">
              <% warning.pair.forEach((name) => { %>
                <li><%- include('partials/chip', { text: name, category: '' }) %></li>
              <% }) %>
            </ul>
            <p class="insight__reason"><%= warning.reason %></p>
            <% if (warning.inSameProduct) { %>
              <p class="insight__reason">Both are in the same product.</p>
            <% } %>
            <p class="insight__source"><a href="<%= warning.sourceUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Source: <%= warning.sourceName || 'link' %> for <%= warning.title %> (opens in a new tab)">Source: <%= warning.sourceName || 'link' %></a></p>
            <p class="insight__precaution"><%= panel.precaution %></p>
          </article>
        <% }) %>
      <% } else if (panel.conflicts.status === 'clear') { %>
        <div class="calm">
          <h4 class="calm__title"><%= panel.conflicts.heading %></h4>
          <ul class="calm__checks">
            <% panel.conflicts.checks.forEach((check) => { %>
              <li><span class="calm__tick" aria-hidden="true">✓</span><%= check %></li>
            <% }) %>
          </ul>
          <p class="calm__reminder"><%= panel.conflicts.reminder %></p>
        </div>
      <% } else { %>
        <p class="field__hint"><%= panel.conflicts.message %></p>
      <% } %>
    </section>
  <% }) %>
</div>

<%- include('partials/disclaimer') %>

<%- include('partials/foot') %>
