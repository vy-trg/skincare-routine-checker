<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Skincare routine checker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="masthead">
  <a class="masthead__name" href="/">Skincare routine checker</a>
  <nav class="masthead__nav" aria-label="Main">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a href="/products">Products</a>
      <a href="/routines/am">Morning</a>
      <a href="/routines/pm">Evening</a>
      <form method="post" action="/logout" class="masthead__logout">
        <button type="submit" class="masthead__link">Log Out</button>
      </form>
    <% } else { %>
      <a href="/login">Log In</a>
      <a href="/register">Create Account</a>
    <% } %>
  </nav>
</header>
<main class="page<%= typeof wide !== 'undefined' && wide ? ' page--wide' : '' %><%= typeof home !== 'undefined' && home ? ' page--home' : '' %>">
